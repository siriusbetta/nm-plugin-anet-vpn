FROM archlinux:latest

RUN set -eu; \
    printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\nServer = https://mirror.rackspace.com/archlinux/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist; \
    pacman -Sy --noconfirm archlinux-keyring; \
    n=0; \
    until pacman -Syu --noconfirm --needed --disable-download-timeout \
        base-devel \
        cmake \
        pkgconf \
        networkmanager \
        gtk3 \
        gtk4; do \
      n=$((n + 1)); \
      if [ "$n" -ge 3 ]; then exit 1; fi; \
      sleep 5; \
    done; \
    pacman -Scc --noconfirm; \
    rm -rf /var/cache/pacman/pkg/* /tmp/*

WORKDIR /src
