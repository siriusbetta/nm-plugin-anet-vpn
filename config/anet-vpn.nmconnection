[connection]
id=anet-vpn
uuid=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
type=vpn
autoconnect=false

[vpn]
service-type=org.freedesktop.NetworkManager.anet
gateway=45.149.234.154
program=/usr/local/bin/anet-client
config=/usr/local/etc/client.toml

[ipv4]
method=auto
never-default=false

[ipv6]
method=ignore

[proxy]
